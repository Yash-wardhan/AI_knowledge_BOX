# database Postgress and PGvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_inbox
# Open AI API Key for Prod
OPENAI_API_KEY=

#local LLM

#Gen model
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=your-loaded-model-name

#Embedding Model
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=your-loaded-embedding-model
# Frontend origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
